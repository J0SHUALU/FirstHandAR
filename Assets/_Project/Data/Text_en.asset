  entries:
  - key: app.title
    text: FirstHand
  - key: start.tagline
    text: Practise first aid. Get ready for work.
  - key: start.how_title
    text: How it works
  - key: start.how1
    text: 1. Point your phone at a clear floor.
  - key: start.how2
    text: 2. Tap to place the person who collapsed.
  - key: start.how3
    text: 3. Follow the steps. Listen and read.
  - key: start.how4
    text: 4. Practice first. Then try the Assessment.
